# Public branding. These NEXT_PUBLIC_ values are baked into the client bundle.
# Leave them at the placeholders until you replace them with your own.
NEXT_PUBLIC_SCHEDULER_OWNER_NAME=Your Name
NEXT_PUBLIC_SCHEDULER_OWNER_FIRST_NAME=Your
NEXT_PUBLIC_SCHEDULER_ORGANIZATION=
NEXT_PUBLIC_SCHEDULER_SITE_NAME=
NEXT_PUBLIC_SCHEDULER_SHORT_NAME=Schedule
NEXT_PUBLIC_SCHEDULER_INITIALS=
# Default avatar is /avatar.webp (and /avatar.jpg for social images).
# Put your photo or logo in /public and point these at them if you want.
NEXT_PUBLIC_SCHEDULER_AVATAR=/avatar.webp
NEXT_PUBLIC_SCHEDULER_LOGO=

# Admin Google sign-in. Required in production. Must match the Google account exactly.
ADMIN_GOOGLE_EMAIL=you@example.com

# Admin password fallback for local `next dev` only. Required when NODE_ENV=production
# if you are not using Google sign-in. Local `next dev` falls back to dev-admin-secret
# when this is unset.
ADMIN_SECRET=

# Canonical public origin used in confirmation, change, and cancel links, and
# in production for OAuth redirects. Required in production.
# Example: https://schedule.example.com
APP_ORIGIN=

# Internal notice recipient. Guest mail is never copied here.
# Leave blank to skip internal notices. There is no default address.
NOTIFY_EMAIL=you@example.com
EMAIL_FROM="Your Name <bookings@example.com>"

# Optional privacy-policy contact. Defaults to NOTIFY_EMAIL when unset.
SCHEDULER_PRIVACY_EMAIL=

# Resend (https://resend.com). Leave the key blank to queue mail instead of sending.
RESEND_API_KEY=
# Set to true to queue mail even if a key is present.
EMAIL_DRY_RUN=

# Google Calendar. Leave all of these blank for the mock calendar (dry-run / demo).
# An OAuth refresh token is the simplest path and can also read any calendar
# that the same Google account can see.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Service account alternative. The key must be allowed to impersonate the user
# (domain-wide delegation) or the calendars must be shared with the service account.
# GOOGLE_IMPERSONATE_USER is required when using a service account. There is no default.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATE_USER=

# Calendars checked for conflicts. Comma-separated. The event is created on the
# booking calendar, or on the calendar chosen in admin. There are no default IDs.
GOOGLE_CALENDAR_IDS=
GOOGLE_CALENDAR_OWNER=
GOOGLE_BOOKING_CALENDAR_ID=

# Optional: treat matching calendar events as free (they will not block slots).
# Comma-separated phrases matched against summary, description, and location.
CALENDAR_FREE_KEYWORDS=
# Comma-separated domains. An event is free if the organizer or an attendee
# uses one of these domains. Example: partners.example.com
CALENDAR_FREE_EMAIL_DOMAINS=

# Set to true to keep the mock calendar even when Google credentials exist.
CALENDAR_DRY_RUN=

# Durable store for the US toggle, manual blocks, bookings, and the email queue.
# Connect a private Vercel Blob store, then either set BLOB_READ_WRITE_TOKEN
# or rely on BLOB_STORE_ID plus the project's OIDC token.
# Without Blob, local dev writes .data/store.json. On Vercel the fallback is
# process memory and does not survive a new instance.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/reminders.
CRON_SECRET=
